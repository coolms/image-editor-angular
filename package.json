{
    "name": "@coolms/image-editor-angular",
    "version": "0.1.0",
    "description": "Modern image editor for CoolMS DXP — vanilla TypeScript engine adapter, framework-agnostic",
    "license": "MIT",
    "private": true,
    "type": "module",
    "peerDependencies": {
        "@angular/cdk": "^22.0.0",
        "@angular/common": "^22.0.0",
        "@angular/core": "^22.0.0",
        "@angular/forms": "^22.0.0",
        "@coolms/ui-angular": "^0.1.0",
        "fabric": "^7.3.1",
        "rxjs": "^7.8.0"
    },
    "keywords": [
        "coolms",
        "image-editor",
        "canvas",
        "fabric"
    ],
    "engines": {
        "node": "^22.22.3 || ^24.15.0 || >=26"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/coolms/image-editor-angular.git"
    },
    "scripts": {
        "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
        "typecheck": "tsc -p tsconfig.lib.json --noEmit",
        "lint": "eslint 'src/**/*.ts'",
        "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
    },
    "devDependencies": {
        "@angular/cdk": "^22.1.3",
        "@angular/common": "^22.1.3",
        "@angular/compiler": "^22.1.3",
        "@angular/compiler-cli": "^22.1.3",
        "@angular/core": "^22.1.3",
        "@angular/forms": "^22.1.3",
        "ng-packagr": "^22.1.1",
        "rxjs": "^7.8.0",
        "tslib": "^2.3.0",
        "typescript": "^6.0.0"
    }
}
